  """
  Create or update a post draft
  """
  postDraft("Draft ID (null = create new)" id: Int, "Draft title" title: String, "TipTap JSON content" content: String, "Tag values" tags: [String], is_own: Boolean, is_nsfw: Boolean, is_cruel: Boolean, is_politics: Boolean, is_postponed: Boolean, postponed_date: String, "Post this draft answers to" parent_post_id: Int, "Comment this draft answers to" parent_comment_id: Int): PostDraft

  """
  Создать или отредактировать серию постов
  """
  seriesSave(id: Int, title: String!, description: String, cover: String): SeriesResponse

  """
  Управление составом и порядком серии
  """
  seriesPost(action: String!, series_id: Int, post_id: Int, post_ids: [Int]): DefaultResponse

  """
  Подписка на серию: 1 — подписаться, 0 — отписаться
  """
  seriesSubscription(series_id: Int!, action: Int!): DefaultResponse

  """

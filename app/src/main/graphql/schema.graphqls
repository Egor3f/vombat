  A mutation
  """
  postMutationExtended(post_id: Int, action: String): DefaultResponse

  """
  A mutation
  """
  userMutationExtended(user_id: Int, action: String): DefaultResponse

  """
  Ban a user with a reason and optional expiration
  """
  userBan(user_id: Int!, duration_minutes: Int, reason: String!): DefaultResponse

  """
  Submit a Fingerprint requestId issued for a challenge
  """
  fingerprintSubmit(nonce: String!, request_id: String, failure: String): DefaultResponse

  """
  A mutation that add/updates subscription to user
  """
  userSubscription(user_id_to: Int, action: Int): DefaultResponse

  """
  A mutation that sets user`s last_viewed_at field
  """
  setUserViewedSubsList: DefaultResponse

  """
  A mutation
  """
  postFavorite(post_id: Int!, action: Int): DefaultResponse

  """
  A mutation
  """
  pollVote(poll_id: Int, poll_option_ids: [Int]): Poll

  """
  Create or update a poll, returns poll_id
  """
  pollSave(id: Int, title: String!, options: [String]!, is_multiple_choice: Boolean, end_time_at: String): Int

  """
  Set is_closed flag on a poll owned by the current user
  """
  pollClose(poll_id: Int!, is_closed: Boolean!): Boolean

  """
  A mutation
  """
  postView(ids: [Int]): Boolean

  """
  A mutation
  """
  userSettings(settings: String): Boolean

  """
  A mutation
  """
  postDelete(post_id: Int): DefaultResponse

  """
  A mutation
  """
  postponedPostDelete(id: Int): DefaultResponse

  """
  A mutation
  """
  oAuth(provider: String, params: String): OAuthResponse

  """
  A mutation
  """
  tagSubscription(tag_id: Int, tag_name: String, action: Int): DefaultResponse

  """
  A mutation
  """

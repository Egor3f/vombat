  """
  Is Post in Favorites
  """
  is_in_favorites: Boolean

  """
  Post Favorites Amount
  """
  in_favorites_amount: Int

  """
  Is Post Original
  """
  is_own: Boolean

  """
  Is Post Long
  """
  is_long_post: Boolean

  """
  Is NSFW
  """
  is_nsfw: Boolean

  """
  Is Cruel
  """
  is_cruel: Boolean

  """
  Is Politics
  """
  is_politics: Boolean

  """
  Is Sensitive Content Hidden
  """
  is_sensitive_content_hidden: Boolean

  """
  Is Blur Sensitive Content
  """
  is_blur_sensitive_content: Boolean

  """
  Is Imported
  """
  is_imported: Boolean

  """
  Is Post Editable
  """
  is_editable: Boolean

  """
  Is Post Deletable
  """
  is_can_delete: Boolean

  """
  Is Post Republishable
  """
  is_can_republish: Boolean

  """
  Date Created
  """
  created_at: String

  """
  Author Login
  """
  login: String

  """
  Author Avatar
  """
  avatar: String

  """
  Is Author Verified
  """
  is_user_verified: Boolean

  """
  Post Status
  """
  status: Int

  """
  User Group
  """
  user_group: Int

  """
  Microdata
  """
  microdata: String

  """
  Microdata Short (Listings)
  """
  microdata_short: String

  """
  Is Deleted
  """
  is_deleted: Boolean

  """
  Is Postponed
  """
  is_postponed: Boolean

  """
  Is Hidden for Editing
  """
  is_hidden_on_editing: Boolean

  """
  Is On Moderation
  """
  is_on_moderation: Boolean

  """
  Postponed Date
  """
  postponed_date_utc: String

  """
  Views Amount
  """
  views_amount: Int

  """
  Author
  """
  user: User

  """
  Title highlights
  """
  title_highlights: [String]

  """
  Content highlights
  """
  content_highlights: [String]

  """
  Tags highlights
  """
  tags_highlights: [String]
}


type Query {
  """
  A query to get Posts List
  """
  posts(page: Int, period: String, type: String, user_id: Int, tag: String, search_keyword: String, is_own: Boolean, is_mine: Boolean, pagination_key: String, is_show_viewed: Boolean, status: Int, is_imported: Boolean, similar_to_id: Int): PostPagination

  """
  A query to get Single Post
  """
  post(id: Int): Post

  """
  A query
  """
  tags(tag_part: String!): [Tag]

  """
  A query
  """
  rating(type: String!, ids: [Int]!): [Rating]

  """
  A query
  """
  comments(post_id: Int): Comments

  """
  A query
  """
  me: Me

  """
  A query
  """
  user(login: String!): User

  """
  Ban history of a user (moderators only)
  """
  userBans(user_id: Int!): [UserBan]

  """
  One-time nonce if a device fingerprint should be collected now
  """
  fingerprintChallenge: String

  """
  Devices of a user and accounts linked by them (moderators only)
  """
  userFingerprints(user_id: Int!): [UserFingerprint]

  """
  Accounts linked by device and/or IP (moderators only)
  """
  userConnections(user_id: Int!): [UserConnection]

  """
  A query
  """
  users(keyword: String): [User]

  """
  A query
  """
  notifications(type: Int, page: Int, is_show_viewed: Boolean): NotificationPagination

  """
  A query
  """
  notificationsCount(type: Int): [NotificationCount]

  """
  A query
  """
  importPossibility(login: String!): DefaultResponse

  """
  A query
  """
  importConfirmationCode: ImportConfirmationCodeResponse

  """
  A query
  """
  importPostsFetchRequest: ImportPostsFetchRequestResponse

  """
  A query
  """
  tagIgnore(page: Int, tag_name: String): TagIgnorePagination

  """
  A query
  """
  userIgnore(page: Int): UserIgnorePagination

  """
  A query
  """
  addPostPreflight: DefaultResponse

  """
  A query
  """
  myComments(page: Int, user_id: Int): CommentPagination

  """
  A query that retrieves posts list from cache
  """
  postsWithCache(page: Int, period: String, type: String, user_id: Int, tag: String, search_keyword: String, is_own: Boolean, is_mine: Boolean, pagination_key: String, is_show_viewed: Boolean, status: Int, is_imported: Boolean, similar_to_id: Int): PostPagination

  """
  A query that retrieves single post from cache
  """
  postWithCache(id: Int): Post

  """
  A query that retrieves subscription list for user
  """
  userSubscriptions: [User]

  """
  A query that retrieves list of users that subscribed to me
  """
  usersSubscribedToMe: [User]

  """
  A query that retrieves subscribed posts count for badge
  """
  userHasSubscribedPosts: Int

  """
  A query
  """
  topComments("top (по рейтингу, по умолчанию) или random (случайные из тех же кандидатов)" mode: String): [Comment]

  """
  A query
  """
  mostDiscussedPosts: [Post]

  """
  A query
  """
  poll(id: Int): Poll

  """
  A query
  """
  postponedPosts(page: Int, destination: String, status: String): PostponedPostPagination

  """
  Батч «сколько новых комментариев» по списку постов для текущего юзера
  """
  newCommentsCounts(post_ids: [Int]!): [NewCommentsCount]

  """
  A query
  """
  allComments(page: Int): CommentPagination

  """
  A query that retrieves tag subscription list for user
  """
  tagSubscriptions(page: Int, tag_name: String): TagSubscriptionPagination

  """
  A query
  """
  myAchievementsChallenge: MyAchievementsChallenge

  """
  A query
  """
  gameInteractions(page: Int, status: String, type: String, source_is_me: Boolean, target_is_me: Boolean, is_new: Boolean, top_level_only: Boolean): GameInteractionPagination

  """
  A query
  """
  gameAttackTools: [GameUserInventoryTool]

  """
  A query
  """
  gameDefenseTools: [GameUserInventoryTool]

  """
  A query
  """
  gameState(user_id: Int): GameState

  """
  A query
  """
  gameUserAttackTools("The ID of the target user" target_user_id: Int!): GameUserAttackPossibility

  """
  A query
  """
  gameTools: GameUserInventoryTools

  """
  A query
  """
  gameRating("The period of the rating" period: String, "The type of the rating" rating_type: String): [GameRatingScore]

  """
  A query
  """
  usersSearch(keyword: String, page: Int = 1, per_page: Int = 20): UserPagination

  """
  A query
  """
  tagsSearch(keyword: String, page: Int = 1, per_page: Int = 20): TagPagination

  """
  List of current user post drafts
  """
  postDrafts: [PostDraft]

  """
  Серия по id или alias
  """
  series(id: Int, alias: String): Series

  """
  Серии автора или каталог серий
  """
  seriesList(user_id: Int, mine: Boolean, subscribed: Boolean, query: String, sort: String, limit: Int, page: Int): [Series]

  """
  Свои посты для добавления в серию
  """
  seriesCandidates(query: String, limit: Int, series_id: Int): [Post]

  """
  Случайная серия для виджета в сайдбаре
  """
  randomSeries(exclude_id: Int): Series

  """
  Закреплённые ссылки правого сайдбара
  """
  pinnedLinks: [PinnedLink]

  """
  Get a single post draft by ID
  """
  postDraft("Draft ID" id: Int!): PostDraft
}


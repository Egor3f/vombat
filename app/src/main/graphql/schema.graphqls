  """
  Pluses
  """
  pluses: Int

  """
  Minuses
  """
  minuses: Int

  """
  Comments Amount
  """
  comments_amount: Int

  """
  Post this one answers to
  """
  parent_id: Int

  """
  Comment this post answers to
  """
  parent_comment_id: Int

  """
  Amount of answer posts
  """
  answers_amount: Int

  """
  Series this post belongs to
  """
  series_id: Int

  """
  Order inside the series
  """
  series_position: Int

  """
  Series relation
  """
  series: Series

  """
  Author Id
  """
  user_id: Int

  """
  Tags List
  """
  tags: [Tag]

  """
  Rated State
  """
  user_rating_value: Int

  """
  Reaction counts as JSON
  """
  reactions_serialized: String

  """
  Reaction code left by the current user
  """
